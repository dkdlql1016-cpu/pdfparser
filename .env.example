# Copy this file to .env, then paste your real values there.
# Do not commit .env.

# Required for AI Resolution Check.
# Set the key that matches AI_ASSESSMENT_MODEL provider.
# - Claude model   -> ANTHROPIC_API_KEY
# - GPT/o* model   -> OPENAI_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Leave blank to use the app default.
#
# Copy exactly one of these examples if you want to pin a model:
#
# Best default for review quality:
# AI_ASSESSMENT_MODEL=claude-3-5-sonnet-latest
#
# Faster / cheaper:
# AI_ASSESSMENT_MODEL=claude-3-5-haiku-latest
#
# Stronger but usually slower / more expensive:
# AI_ASSESSMENT_MODEL=claude-3-opus-latest
#
# GPT/OpenAI model name examples:
# AI_ASSESSMENT_MODEL=gpt-4o
# AI_ASSESSMENT_MODEL=gpt-4o-mini
# AI_ASSESSMENT_MODEL=gpt-4.1
# AI_ASSESSMENT_MODEL=gpt-4.1-mini
AI_ASSESSMENT_MODEL=
